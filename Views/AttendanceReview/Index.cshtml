@model List<AmpmHrmsPro.Models.AttendanceImport>
@{
    ViewData["Title"]    = "Attendance Review";
    ViewData["Subtitle"] = "Upload daily Presence 360 report and review attendance gaps";
}

<div class="page-header">
    <div>
        <h1>Attendance Review</h1>
        <p>Upload the Presence 360 daily CSV to detect gaps for your team.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    var ds = ViewBag.DataStatus as AmpmHrmsPro.Services.ReviewDataStatus;
}
<div class="card mb-3">
    <div class="card-header">
        <i class="bi bi-database-check me-1" style="color:var(--primary);"></i>
        Gap Analysis data — the HoD report (Summary · Daily Detail (MTD) · Gaps Only) is built from these three
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="fw-semibold mb-1"><span class="badge bg-primary me-1">1</span> Roster</div>
                <div class="small text-muted mb-2">Attendance Management.xlsx — plan, shift, WFH/STORE/OFFICE, buffer (all month sheets)</div>
                <div class="small mb-2">
                    @if (ds != null && ds.RosterRows > 0)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> @ds.RosterRows.ToString("N0") rows · @(string.Join(", ", ds.RosterMonths))</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="bi bi-exclamation-circle-fill"></i> Not uploaded — plan/shift will be taken from Presence 360</span>
                    }
                </div>
                <form asp-action="UploadRoster" asp-controller="AttendanceReview" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="rosterFile" accept=".xlsx" class="form-control form-control-sm" required />
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Upload</button>
                </form>
            </div>
            <div class="col-md-4">
                <div class="fw-semibold mb-1"><span class="badge bg-primary me-1">2</span> Master Sheet</div>
                <div class="small text-muted mb-2">Employee Master — who reports to whom (decides each HoD's team, every level)</div>
                <div class="small mb-2">
                    @if (ds != null && ds.MasterEmployees > 0)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> @ds.MasterEmployees employees</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="bi bi-exclamation-circle-fill"></i> Not uploaded — HRMS Reporting Manager will be used</span>
                    }
                </div>
                <form asp-action="UploadMaster" asp-controller="AttendanceReview" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="file" name="masterFile" accept=".xlsx" class="form-control form-control-sm" required />
                    <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Upload</button>
                </form>
            </div>
            <div class="col-md-4">
                <div class="fw-semibold mb-1"><span class="badge bg-primary me-1">3</span> Presence 360 daily CSV</div>
                <div class="small text-muted mb-2">Actual in/out + status — upload below every day</div>
                <div class="small">
                    @if (ds?.LatestP360Date != null)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill"></i> Latest date: @ds.LatestP360Date.Value.ToString("dd MMM yyyy")</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="bi bi-exclamation-circle-fill"></i> No Presence 360 data yet</span>
                    }
                </div>
                <div class="small text-muted mt-2">Roster & Master: upload again whenever they change.</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-upload me-1" style="color:var(--primary);"></i>
                Upload Presence 360 CSV
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Download the daily attendance report from Presence 360 and upload here.
                    The system will auto-detect late comings, short hours, extra time, and unplanned absences.
                </p>
                <form asp-action="Upload" asp-controller="AttendanceReview" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select CSV File</label>
                        <input type="file" name="csvFile" accept=".csv" class="form-control" required />
                        <div class="form-text">Export from Presence 360 → Reports → Daily Attendance</div>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-cloud-upload-fill me-1"></i> Upload & Detect Gaps
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-info-circle me-1" style="color:var(--info);"></i>
                Gap Detection Rules
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background:var(--warning-light);">
                            <div class="fw-semibold mb-1" style="color:var(--warning);font-size:13px;">
                                <i class="bi bi-clock me-1"></i> Late Coming
                            </div>
                            <div class="text-muted" style="font-size:12px;">
                                Arrived after roster In Time + late buffer (default 10 min)
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background:var(--info-light);">
                            <div class="fw-semibold mb-1" style="color:var(--info);font-size:13px;">
                                <i class="bi bi-hourglass-bottom me-1"></i> Short Hours
                            </div>
                            <div class="text-muted" style="font-size:12px;">
                                Worked less than planned hours (Roster Out − In)
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background:var(--success-light);">
                            <div class="fw-semibold mb-1" style="color:var(--success);font-size:13px;">
                                <i class="bi bi-hourglass-top me-1"></i> Extra Time
                            </div>
                            <div class="text-muted" style="font-size:12px;">
                                Worked 30+ min more than planned hours
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background:var(--danger-light);">
                            <div class="fw-semibold mb-1" style="color:var(--danger);font-size:13px;">
                                <i class="bi bi-person-x me-1"></i> Absent / Unplanned
                            </div>
                            <div class="text-muted" style="font-size:12px;">
                                Absent with no planned leave in roster
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-clock-history me-1" style="color:var(--primary);"></i>
        Import History
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted small p-3 mb-0">No imports yet. Upload your first CSV above.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="font-size:13px;">
                    <thead style="background:var(--bg-light);">
                        <tr>
                            <th>File</th>
                            <th>Date Range</th>
                            <th>Records</th>
                            <th>Gaps</th>
                            <th>Imported By</th>
                            <th>Imported At</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var imp in Model)
                        {
                            <tr>
                                <td><i class="bi bi-file-earmark-text me-1 text-muted"></i>@imp.FileName</td>
                                <td>@imp.FromDate.ToString("dd MMM") – @imp.ToDate.ToString("dd MMM yyyy")</td>
                                <td>@imp.RecordsProcessed</td>
                                <td>
                                    <span class="badge rounded-pill" style="background:var(--danger-light);color:var(--danger);">
                                        @imp.GapsDetected
                                    </span>
                                </td>
                                <td>@imp.ImportedBy</td>
                                <td>@imp.ImportedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td>
                                    <a href="@Url.Action("GapReport", "AttendanceReview", new { id = imp.Id })"
                                       class="btn btn-sm" style="background:var(--primary-light);color:var(--primary-dark);">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
