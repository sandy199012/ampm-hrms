@model NewCompanyResult
@{ ViewData["Title"] = "Company created"; var url = $"{Context.Request.Scheme}://{Context.Request.Host}/Account/Login?company={Model.Company.Code}"; }
<div class="card" style="max-width:640px;">
    <div class="card-body">
        <h1 class="h4"><i class="bi bi-check-circle-fill text-success me-1"></i> @Model.Company.Name is ready</h1>
        <p class="text-muted">Share these login details with the company. The password is shown only once.</p>
        <table class="table">
            <tr><th style="width:170px;">Login page</th><td><a href="@url">@url</a></td></tr>
            <tr><th>Company code</th><td><code>@Model.Company.Code</code></td></tr>
            <tr><th>Login code</th><td><code>@Model.AdminEmpCode</code></td></tr>
            <tr><th>Password</th><td><code>@Model.AdminPassword</code> <span class="small text-muted">(must be changed at first login)</span></td></tr>
            <tr><th>Plan</th><td>@Model.Company.Plan · @(Model.Company.MaxEmployees == 0 ? "unlimited" : Model.Company.MaxEmployees + " employees") @(Model.Company.TrialEndsAt is DateTime t ? "· trial till " + IndiaTime.FromUtc(t).ToString("dd MMM yyyy") : "")</td></tr>
        </table>
        <a asp-action="Edit" asp-route-id="@Model.Company.Id" class="btn btn-primary">Manage company</a>
        <a asp-action="Index" class="btn btn-link">All companies</a>
    </div>
</div>
