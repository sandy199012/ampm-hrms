@{
    ViewData["Title"] = "Assign OT Rule";
    ViewData["Subtitle"] = "Overtime";
    var rules     = (List<OTRule>)ViewBag.RuleList;
    var grades    = (List<Grade>)ViewBag.GradeList;
    var categories = (List<string>)ViewBag.CategoryList;
    var employees = (List<Employee>)ViewBag.EmployeeList;
}

<div class="page-header">
    <div>
        <h1>Assign OT Rule</h1>
        <p>Category-wise, Grade-wise, or one Employee at a time — whichever you run last wins for an employee</p>
    </div>
    <a asp-action="Rules" class="btn btn-light"><i class="bi bi-clock-history me-1"></i>Manage Rules</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"]   != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card mb-3">
    <div class="card-body p-0">
        <ul class="nav nav-tabs-pro px-3 pt-2">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#t-cat"  type="button">Category-wise</button></li>
            <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#t-grade" type="button">Grade-wise</button></li>
            <li class="nav-item"><button class="nav-link"        data-bs-toggle="tab" data-bs-target="#t-emp"   type="button">Employee-wise</button></li>
        </ul>
        <div class="tab-content p-3">
            <div class="tab-pane fade show active" id="t-cat">
                <form method="post" asp-action="AssignByCategory" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-5">
                        <label class="form-label">Category</label>
                        <select name="category" class="form-select" required>
                            <option value="">— Select Category —</option>
                            @foreach (var c in categories) { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">OT Rule</label>
                        <select name="ruleId" class="form-select">
                            <option value="">— Clear (no rule) —</option>
                            @foreach (var r in rules) { <option value="@r.Id">@r.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Apply</button></div>
                    <div class="col-12 form-text">Applies to every active employee whose Category matches.</div>
                </form>
            </div>
            <div class="tab-pane fade" id="t-grade">
                <form method="post" asp-action="AssignByGrade" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-5">
                        <label class="form-label">Grade</label>
                        <select name="gradeId" class="form-select" required>
                            <option value="">— Select Grade —</option>
                            @foreach (var g in grades) { <option value="@g.Id">@g.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">OT Rule</label>
                        <select name="ruleId" class="form-select">
                            <option value="">— Clear (no rule) —</option>
                            @foreach (var r in rules) { <option value="@r.Id">@r.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Apply</button></div>
                </form>
            </div>
            <div class="tab-pane fade" id="t-emp">
                <form method="post" asp-action="AssignByEmployee" class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-5">
                        <label class="form-label">Employee</label>
                        <select name="employeeId" class="form-select" required>
                            <option value="">— Select Employee —</option>
                            @foreach (var e in employees) { <option value="@e.Id">@e.Name (@e.EmpCode)</option> }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">OT Rule</label>
                        <select name="ruleId" class="form-select">
                            <option value="">— Clear (no rule) —</option>
                            @foreach (var r in rules) { <option value="@r.Id">@r.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Apply</button></div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Employee</th><th>Grade</th><th>Category</th><th>Current OT Rule</th></tr></thead>
        <tbody>
        @if (!employees.Any())
        {
            <tr><td colspan="4"><div class="empty-state"><i class="bi bi-people"></i>No active employees.</div></td></tr>
        }
        @foreach (var e in employees)
        {
            <tr>
                <td class="fw-semibold">@e.Name <span class="text-muted">(@e.EmpCode)</span></td>
                <td>@(e.Grade?.Name ?? "—")</td>
                <td>@(e.Category ?? "—")</td>
                <td>
                    @if (e.OTRule != null)
                    { <span class="badge badge-soft-info">@e.OTRule.Name</span> }
                    else
                    { <span class="badge badge-soft-gray">Unassigned</span> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
