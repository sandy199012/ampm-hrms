@model List<Holiday>
@{
    ViewData["Title"] = "Holidays";
    ViewData["Subtitle"] = "Organization Masters";
    var year = (string)ViewBag.Year;
    var types = new[] { "National","Festival","Company","Optional","Restricted","Regional" };
}

<div class="page-header">
    <div>
        <h1>Holiday Calendar</h1>
        <p>@Model.Count holiday(s) in @year</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="year" class="form-select" onchange="this.form.submit()">
                @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 2; y++)
                {
                    <option value="@y" selected="@(y.ToString()==year)">@y</option>
                }
            </select>
        </form>
        <button class="btn btn-primary" onclick="openModal(null,'','@year-01-01','Company')"><i class="bi bi-plus-lg me-1"></i>Add Holiday</button>
    </div>
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Holiday Name</th><th>Date</th><th>Day</th><th>Type</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="5"><div class="empty-state"><i class="bi bi-calendar-event"></i>No holidays added for @year yet.</div></td></tr>
        }
        @foreach (var h in Model)
        {
            var dayName = DateTime.TryParse(h.Date, out var dt) ? dt.ToString("dddd") : "—";
            <tr>
                <td class="fw-semibold" style="color:var(--text);">@h.Name</td>
                <td>@h.Date</td>
                <td class="text-soft">@dayName</td>
                <td><span class="badge badge-soft-primary">@h.Type</span></td>
                <td class="text-end">
                    <button class="btn btn-sm btn-light" onclick='openModal(@h.Id, @Html.Raw(Json.Serialize(h.Name)), @Html.Raw(Json.Serialize(h.Date)), @Html.Raw(Json.Serialize(h.Type)))'><i class="bi bi-pencil-fill"></i></button>
                    <button class="btn btn-sm btn-light text-danger" onclick="deleteIt(@h.Id)"><i class="bi bi-trash-fill"></i></button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="SaveHoliday" id="itemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Holiday</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="fId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Holiday Name *</label>
                        <input type="text" name="Name" id="fName" class="form-control" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Date *</label>
                            <input type="date" name="Date" id="fDate" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Type</label>
                            <select name="Type" id="fType" class="form-select">
                                @foreach (var t in types) { <option value="@t">@t</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
function openModal(id, name, date, type) {
    document.getElementById('modalTitle').innerText = id ? 'Edit Holiday' : 'Add Holiday';
    document.getElementById('fId').value = id || 0;
    document.getElementById('fName').value = name || '';
    document.getElementById('fDate').value = date || '';
    document.getElementById('fType').value = type || 'Company';
    itemModal.show();
}
function deleteIt(id) {
    if (!confirm('Delete this holiday?')) return;
    fetch('@Url.Action("DeleteHoliday")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
</script>
}
