@model List<Shift>
@{
    ViewData["Title"] = "Shifts";
    ViewData["Subtitle"] = "Organization Masters";
    var shiftTypes = new[] { "General","Fixed","Flexible","Rotational","Night","Split" };
}

<div class="page-header">
    <div>
        <h1>Shift Master</h1>
        <p>@Model.Count shift(s) configured</p>
    </div>
    <button class="btn btn-primary" onclick="openModal(null,'','09:30','18:30',10,4,8,'General')"><i class="bi bi-plus-lg me-1"></i>Add Shift</button>
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Shift Name</th><th>Type</th><th>Timing</th><th>Grace</th><th>Half Day &lt;</th><th>Full Day &ge;</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="8"><div class="empty-state"><i class="bi bi-clock"></i>No shifts configured yet.</div></td></tr>
        }
        @foreach (var s in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:var(--text);">@s.Name</td>
                <td><span class="badge badge-soft-info">@s.ShiftType</span></td>
                <td>@s.StartTime.ToString(@"hh\:mm") — @s.EndTime.ToString(@"hh\:mm")</td>
                <td>@s.GraceMinutes min</td>
                <td>@s.HalfDayThresholdHours hrs</td>
                <td>@s.FullDayThresholdHours hrs</td>
                <td>@(s.IsActive ? Html.Raw("<span class='badge badge-soft-success'>Active</span>") : Html.Raw("<span class='badge badge-soft-gray'>Inactive</span>"))</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-light" onclick='openModal(@s.Id, @Html.Raw(Json.Serialize(s.Name)), "@s.StartTime.ToString(@"hh\:mm")", "@s.EndTime.ToString(@"hh\:mm")", @s.GraceMinutes, @s.HalfDayThresholdHours, @s.FullDayThresholdHours, @Html.Raw(Json.Serialize(s.ShiftType)))'><i class="bi bi-pencil-fill"></i></button>
                    <button class="btn btn-sm btn-light" onclick="toggleIt(@s.Id)"><i class="bi bi-toggle2-on"></i></button>
                    <button class="btn btn-sm btn-light text-danger" onclick="deleteIt(@s.Id)"><i class="bi bi-trash-fill"></i></button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="SaveShift" id="itemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Shift</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="fId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Shift Name *</label>
                        <input type="text" name="Name" id="fName" class="form-control" required placeholder="e.g. General Shift" />
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Start Time *</label>
                            <input type="time" name="StartTime" id="fStart" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">End Time *</label>
                            <input type="time" name="EndTime" id="fEnd" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Shift Type</label>
                            <select name="ShiftType" id="fType" class="form-select">
                                @foreach (var t in shiftTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Grace (minutes)</label>
                            <input type="number" name="GraceMinutes" id="fGrace" class="form-control" min="0" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Half-Day Threshold (hrs)</label>
                            <input type="number" step="0.5" name="HalfDayThresholdHours" id="fHalf" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Full-Day Threshold (hrs)</label>
                            <input type="number" step="0.5" name="FullDayThresholdHours" id="fFull" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
function openModal(id, name, start, end, grace, half, full, type) {
    document.getElementById('modalTitle').innerText = id ? 'Edit Shift' : 'Add Shift';
    document.getElementById('fId').value = id || 0;
    document.getElementById('fName').value = name || '';
    document.getElementById('fStart').value = start || '09:30';
    document.getElementById('fEnd').value = end || '18:30';
    document.getElementById('fGrace').value = grace ?? 10;
    document.getElementById('fHalf').value = half ?? 4;
    document.getElementById('fFull').value = full ?? 8;
    document.getElementById('fType').value = type || 'General';
    itemModal.show();
}
function toggleIt(id) {
    fetch('@Url.Action("ToggleShift")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
function deleteIt(id) {
    if (!confirm('Delete this shift? If in use, it will be deactivated instead.')) return;
    fetch('@Url.Action("DeleteShift")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { alert(d.message || 'Done.'); if (d.success) location.reload(); });
}
</script>
}
