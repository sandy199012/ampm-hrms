@model List<Location>
@{
    ViewData["Title"] = "Locations";
    ViewData["Subtitle"] = "Organization Masters";
}

<div class="page-header">
    <div>
        <h1>Locations / Branches</h1>
        <p>@Model.Count location(s) configured</p>
    </div>
    <button class="btn btn-primary" onclick="openModal(null,'','','','','')"><i class="bi bi-plus-lg me-1"></i>Add Location</button>
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Name</th><th>Code</th><th>City</th><th>State</th><th>Address</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7"><div class="empty-state"><i class="bi bi-geo-alt"></i>No locations yet.</div></td></tr>
        }
        @foreach (var l in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:var(--text);">@l.Name</td>
                <td>@(l.Code ?? "—")</td>
                <td>@(l.City ?? "—")</td>
                <td>@(l.State ?? "—")</td>
                <td class="text-soft">@(l.Address ?? "—")</td>
                <td>@(l.IsActive ? Html.Raw("<span class='badge badge-soft-success'>Active</span>") : Html.Raw("<span class='badge badge-soft-gray'>Inactive</span>"))</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-light" onclick='openModal(@l.Id, @Html.Raw(Json.Serialize(l.Name)), @Html.Raw(Json.Serialize(l.Code ?? "")), @Html.Raw(Json.Serialize(l.City ?? "")), @Html.Raw(Json.Serialize(l.State ?? "")), @Html.Raw(Json.Serialize(l.Address ?? "")))'><i class="bi bi-pencil-fill"></i></button>
                    <button class="btn btn-sm btn-light" onclick="toggleIt(@l.Id)"><i class="bi bi-toggle2-on"></i></button>
                    <button class="btn btn-sm btn-light text-danger" onclick="deleteIt(@l.Id)"><i class="bi bi-trash-fill"></i></button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="SaveLocation" id="itemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="fId" value="0" />
                    <div class="mb-3">
                        <label class="form-label">Location Name *</label>
                        <input type="text" name="Name" id="fName" class="form-control" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="form-label">Code</label>
                            <input type="text" name="Code" id="fCode" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">City</label>
                            <input type="text" name="City" id="fCity" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">State</label>
                            <input type="text" name="State" id="fState" class="form-control" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Address</label>
                        <textarea name="Address" id="fAddress" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
function openModal(id, name, code, city, state, address) {
    document.getElementById('modalTitle').innerText = id ? 'Edit Location' : 'Add Location';
    document.getElementById('fId').value = id || 0;
    document.getElementById('fName').value = name || '';
    document.getElementById('fCode').value = code || '';
    document.getElementById('fCity').value = city || '';
    document.getElementById('fState').value = state || '';
    document.getElementById('fAddress').value = address || '';
    itemModal.show();
}
function toggleIt(id) {
    fetch('@Url.Action("ToggleLocation")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
function deleteIt(id) {
    if (!confirm('Delete this location? If in use, it will be deactivated instead.')) return;
    fetch('@Url.Action("DeleteLocation")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { alert(d.message || 'Done.'); if (d.success) location.reload(); });
}
</script>
}
