@{
    ViewData["Title"] = "Leave Balance — Bulk Upload";
    int year = ViewBag.Year;
}

<style>
    .upload-card { max-width:600px; }
    .format-box { background:#f8f9fa; border:1px solid #dee2e6; border-radius:8px; padding:1rem; font-size:.78rem; }
    .format-box code { display:block; margin-top:.35rem; color:#0d6efd; }
</style>

<div class="card upload-card">
    <div class="card-header fw-semibold">
        <i class="bi bi-file-earmark-arrow-up"></i> Import EL / CL / SL Leave Balance from Excel
    </div>
    <div class="card-body">
        <form asp-action="BulkUpload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Leave Type <span class="text-danger">*</span></label>
                <select name="leaveTypeCode" class="form-select" required>
                    <option value="">— Select —</option>
                    <option value="EL">EL (Earned / Privilege Leave)</option>
                    <option value="CL">CL (Casual Leave)</option>
                    <option value="SL">SL (Sick Leave)</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Year <span class="text-danger">*</span></label>
                <select name="year" class="form-select" required>
                    @for (int y = year + 1; y >= year - 2; y--)
                    {
                        <option value="@y" selected="@(y==year)">@y</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Excel File <span class="text-danger">*</span></label>
                <input type="file" name="file" class="form-control" accept=".xlsx,.xls" required />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-cloud-upload"></i> Upload &amp; Import
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<div class="mt-4 format-box">
    <strong>Expected Excel Column Layout (rows 4 onwards)</strong>
    <p class="mt-2 mb-1">Use the <strong>EL_BulkUpload_Template.xlsx</strong> or <strong>CL_BulkUpload_Template.xlsx</strong> files as the upload template. The system reads these exact columns:</p>
    <code>A = S.No (ignored)</code>
    <code>B = Employee Code  ← must match the Emp Code in HRMS exactly</code>
    <code>C = Name (ignored)</code>
    <code>D = Date of Joining (ignored)</code>
    <code>E = Service Years (ignored)</code>
    <code>F = Carry Forward (opening balance from previous year)</code>
    <code>G–R = Earned Jan through Dec (12 months)</code>
    <code>S–AD = Consumed Jan through Dec (12 months)</code>
    <p class="mt-2 mb-0 text-muted">
        Data starts at <strong>row 4</strong> (rows 1–3 are header/title rows).<br />
        Existing records for the same Employee + Leave Type + Year are <strong>overwritten</strong> (not duplicated).<br />
        Employees not found in HRMS are skipped; a warning is shown after upload.
    </p>
</div>
