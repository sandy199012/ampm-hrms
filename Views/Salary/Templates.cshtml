@model List<SalaryStructureTemplate>
@{
    ViewData["Title"] = "Salary Structure Templates";
    ViewData["Subtitle"] = "Salary Structure";
}

<div class="page-header">
    <div>
        <h1>Salary Structure Templates</h1>
        <p>Reusable structures (e.g. one per Grade) you can assign to many employees without re-entering every component</p>
    </div>
    <a class="btn btn-primary" asp-action="TemplateEdit" asp-route-id="0"><i class="bi bi-plus-lg me-1"></i>Add Template</a>
</div>

<div class="row g-3">
@if (!Model.Any())
{
    <div class="col-12"><div class="empty-state"><i class="bi bi-diagram-3"></i>No salary templates yet.</div></div>
}
@foreach (var t in Model)
{
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <div class="fw-bold" style="font-size:15px;color:var(--text);">@t.Name</div>
                        <div class="text-soft" style="font-size:12px;">@(t.Grade?.Name ?? "No grade linked") @(string.IsNullOrWhiteSpace(t.Description) ? "" : $"· {t.Description}")</div>
                    </div>
                    @(t.IsActive ? Html.Raw("<span class='badge badge-soft-success'>Active</span>") : Html.Raw("<span class='badge badge-soft-gray'>Inactive</span>"))
                </div>
                <div class="mb-3">
                    @foreach (var i in t.Items.OrderBy(i => i.DisplayOrder))
                    {
                        <span class="badge badge-soft-primary me-1 mb-1">@(i.SalaryComponent?.Name ?? "—")</span>
                    }
                    @if (!t.Items.Any())
                    {
                        <span class="text-soft" style="font-size:12.5px;">No components added yet</span>
                    }
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-light" asp-action="TemplateEdit" asp-route-id="@t.Id"><i class="bi bi-pencil-fill me-1"></i>Edit</a>
                    <button class="btn btn-sm btn-light" onclick="toggleIt(@t.Id)"><i class="bi bi-toggle2-on"></i></button>
                    <button class="btn btn-sm btn-light text-danger" onclick="deleteIt(@t.Id)"><i class="bi bi-trash-fill"></i></button>
                </div>
            </div>
        </div>
    </div>
}
</div>

@section Scripts {
<script>
function toggleIt(id) {
    fetch('@Url.Action("ToggleTemplate")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
function deleteIt(id) {
    if (!confirm('Delete this template? If in use, it will be deactivated instead.')) return;
    fetch('@Url.Action("DeleteTemplate")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { alert(d.message || 'Done.'); if (d.success) location.reload(); });
}
</script>
}
