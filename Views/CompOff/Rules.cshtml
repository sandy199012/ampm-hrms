@model List<CompOffRule>
@{
    ViewData["Title"] = "Comp-Off Rules";
    ViewData["Subtitle"] = "Comp-Off";
}

<div class="page-header">
    <div>
        <h1>Comp-Off Rule Master</h1>
        <p>Define how compensatory-off is earned, expires, and caps out — then assign a rule to employees from the Assign screen</p>
    </div>
    <button class="btn btn-primary" onclick='openModal(null,"","",8,4,true,true,true,90,"",true)'><i class="bi bi-plus-lg me-1"></i>Add Rule</button>
</div>

<div class="alert alert-primary d-flex align-items-center gap-2 mb-3" style="background:var(--primary-light);color:var(--primary-dark);">
    <i class="bi bi-info-circle-fill"></i> A rule only earns comp-off automatically when Auto-Credit is on and the employee has this rule assigned — see <a asp-controller="CompOff" asp-action="Assign">Assign Comp-Off Rule</a>. Manual entries can still be logged from the <a asp-controller="CompOff" asp-action="Ledger">Ledger</a> regardless.
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Name</th><th>Full Day ≥</th><th>Half Day ≥</th><th>Counts</th><th>Auto-Credit</th><th>Expires After</th><th>Max Balance</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="9"><div class="empty-state"><i class="bi bi-calendar-plus"></i>No Comp-Off rules yet.</div></td></tr>
        }
        @foreach (var r in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:var(--text);">
                    @r.Name
                    @if (!string.IsNullOrWhiteSpace(r.Description)) { <div class="text-muted small">@r.Description</div> }
                </td>
                <td>@r.MinHoursForFullDay hrs</td>
                <td>@(r.MinHoursForHalfDay > 0 ? $"{r.MinHoursForHalfDay} hrs" : "—")</td>
                <td>
                    @if (r.CountHolidays) { <span class="badge badge-soft-primary me-1">Holiday</span> }
                    @if (r.CountWeekOffs) { <span class="badge badge-soft-primary">Week-Off</span> }
                </td>
                <td>@(r.AutoCredit ? Html.Raw("<span class='badge badge-soft-success'>On</span>") : Html.Raw("<span class='badge badge-soft-gray'>Manual only</span>"))</td>
                <td>@r.ExpiryDays days</td>
                <td>@(r.MaxOpenBalance.HasValue ? $"{r.MaxOpenBalance} days" : "No cap")</td>
                <td>@(r.IsActive ? Html.Raw("<span class='badge badge-soft-success'>Active</span>") : Html.Raw("<span class='badge badge-soft-gray'>Inactive</span>"))</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-light" onclick='openModal(@r.Id, @Html.Raw(Json.Serialize(r.Name)), @Html.Raw(Json.Serialize(r.Description)), @r.MinHoursForFullDay, @r.MinHoursForHalfDay, @Json.Serialize(r.CountHolidays), @Json.Serialize(r.CountWeekOffs), @Json.Serialize(r.AutoCredit), @r.ExpiryDays, @Html.Raw(Json.Serialize(r.MaxOpenBalance)), @Json.Serialize(r.IsActive))'><i class="bi bi-pencil-fill"></i></button>
                    <button class="btn btn-sm btn-light" onclick="toggleIt(@r.Id)"><i class="bi bi-toggle2-on"></i></button>
                    <button class="btn btn-sm btn-light text-danger" onclick="deleteIt(@r.Id)"><i class="bi bi-trash-fill"></i></button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="SaveRule" id="itemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Comp-Off Rule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="fId" value="0" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Rule Name *</label>
                            <input type="text" name="Name" id="fName" class="form-control" required placeholder="e.g. Staff Comp-Off" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <input type="text" name="Description" id="fDesc" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Full-Day Hours Threshold *</label>
                            <input type="number" step="0.5" min="0.5" name="MinHoursForFullDay" id="fFull" class="form-control" required />
                            <div class="form-text">Worked this many hours (or more) on a qualifying off-day → 1 full comp-off day.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Half-Day Hours Threshold</label>
                            <input type="number" step="0.5" min="0" name="MinHoursForHalfDay" id="fHalf" class="form-control" />
                            <div class="form-text">0 disables half-day credit entirely.</div>
                        </div>
                        <div class="col-12">
                            <div class="d-flex gap-4 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="CountHolidays" id="fHol" value="true" />
                                    <label class="form-check-label" for="fHol">Counts working on a Holiday</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="CountWeekOffs" id="fWo" value="true" />
                                    <label class="form-check-label" for="fWo">Counts working on a Week-Off</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="AutoCredit" id="fAuto" value="true" />
                                <label class="form-check-label" for="fAuto">Auto-Credit from Attendance</label>
                            </div>
                            <div class="form-text">Off, Admin/HR must log every credit manually from the Ledger.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Expires After (days) *</label>
                            <input type="number" min="1" name="ExpiryDays" id="fExp" class="form-control" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Max Open Balance (days)</label>
                            <input type="number" step="0.5" min="0" name="MaxOpenBalance" id="fMax" class="form-control" placeholder="Leave blank for no cap" />
                        </div>
                        <div class="col-6">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="fActive" value="true" />
                                <label class="form-check-label" for="fActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
function openModal(id, name, desc, full, half, hol, wo, auto, exp, max, active) {
    document.getElementById('modalTitle').innerText = id ? 'Edit Comp-Off Rule' : 'Add Comp-Off Rule';
    document.getElementById('fId').value = id || 0;
    document.getElementById('fName').value = name || '';
    document.getElementById('fDesc').value = desc || '';
    document.getElementById('fFull').value = full ?? 8;
    document.getElementById('fHalf').value = half ?? 4;
    document.getElementById('fHol').checked = hol !== false;
    document.getElementById('fWo').checked = wo !== false;
    document.getElementById('fAuto').checked = auto !== false;
    document.getElementById('fExp').value = exp ?? 90;
    document.getElementById('fMax').value = max ?? '';
    document.getElementById('fActive').checked = active !== false;
    itemModal.show();
}
function toggleIt(id) {
    fetch('@Url.Action("ToggleRule")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
function deleteIt(id) {
    if (!confirm('Delete this rule?')) return;
    fetch('@Url.Action("DeleteRule")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
</script>
}
