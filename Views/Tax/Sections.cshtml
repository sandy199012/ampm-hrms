@model List<TaxSectionMaster>
@{
    ViewData["Title"] = "Tax Sections";
    ViewData["Subtitle"] = "Income Tax";
}

<div class="page-header">
    <div>
        <h1>Tax Section Master</h1>
        <p>The deduction sections employees can declare investments against (80C, 80D, etc.) — limits fully editable</p>
    </div>
    <button class="btn btn-primary" onclick='openModal(null,"","","",null,"Old",true,0,true)'><i class="bi bi-plus-lg me-1"></i>Add Section</button>
</div>

<div class="table-wrap">
    <table class="table">
        <thead><tr><th>Code</th><th>Name</th><th>Max Limit</th><th>Regime</th><th>Doc Required</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7"><div class="empty-state"><i class="bi bi-file-earmark-text"></i>No tax sections yet.</div></td></tr>
        }
        @foreach (var s in Model)
        {
            <tr>
                <td><span class="badge badge-soft-primary">@s.Code</span></td>
                <td class="fw-semibold" style="color:var(--text);">@s.Name</td>
                <td>@(s.MaxLimit.HasValue ? $"₹{s.MaxLimit:N0}" : "No cap")</td>
                <td>@s.ApplicableRegime</td>
                <td>@(s.RequiresDocument ? "✔️" : "—")</td>
                <td>@(s.IsActive ? Html.Raw("<span class='badge badge-soft-success'>Active</span>") : Html.Raw("<span class='badge badge-soft-gray'>Inactive</span>"))</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-light" onclick='openModal(@s.Id, @Html.Raw(Json.Serialize(s.Code)), @Html.Raw(Json.Serialize(s.Name)), @Html.Raw(Json.Serialize(s.Description ?? "")), @(s.MaxLimit.HasValue ? s.MaxLimit.Value.ToString() : "null"), @Html.Raw(Json.Serialize(s.ApplicableRegime)), @Json.Serialize(s.RequiresDocument), @s.DisplayOrder, @Json.Serialize(s.IsActive))'><i class="bi bi-pencil-fill"></i></button>
                    <button class="btn btn-sm btn-light" onclick="toggleIt(@s.Id)"><i class="bi bi-toggle2-on"></i></button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="SaveSection" id="itemForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">Add Section</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="fId" value="0" />
                    <div class="row g-3">
                        <div class="col-4"><label class="form-label">Code *</label><input type="text" name="Code" id="fCode" class="form-control" required maxlength="20" placeholder="80C" /></div>
                        <div class="col-8"><label class="form-label">Name *</label><input type="text" name="Name" id="fName" class="form-control" required placeholder="Section 80C — PPF, ELSS, ..." /></div>
                        <div class="col-12"><label class="form-label">Description</label><input type="text" name="Description" id="fDescription" class="form-control" /></div>
                        <div class="col-4"><label class="form-label">Max Limit (₹, blank = no cap)</label><input type="number" step="0.01" name="MaxLimit" id="fMaxLimit" class="form-control" /></div>
                        <div class="col-4">
                            <label class="form-label">Applicable Regime</label>
                            <select name="ApplicableRegime" id="fRegime" class="form-select">
                                <option value="Old">Old Regime only</option>
                                <option value="Both">Both Regimes</option>
                            </select>
                        </div>
                        <div class="col-4"><label class="form-label">Display Order</label><input type="number" name="DisplayOrder" id="fOrder" class="form-control" /></div>
                        <div class="col-12">
                            <div class="d-flex gap-4 mt-2">
                                <div class="form-check"><input class="form-check-input" type="checkbox" name="RequiresDocument" id="fReqDoc" value="true" /><input type="hidden" name="RequiresDocument" value="false" /><label class="form-check-label" for="fReqDoc">Requires supporting document</label></div>
                                <div class="form-check"><input class="form-check-input" type="checkbox" name="IsActive" id="fActive" value="true" /><input type="hidden" name="IsActive" value="false" /><label class="form-check-label" for="fActive">Active</label></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const itemModal = new bootstrap.Modal(document.getElementById('itemModal'));
function openModal(id, code, name, description, maxLimit, regime, reqDoc, order, active) {
    document.getElementById('modalTitle').innerText = id ? 'Edit Section' : 'Add Section';
    document.getElementById('fId').value = id || 0;
    document.getElementById('fCode').value = code || '';
    document.getElementById('fName').value = name || '';
    document.getElementById('fDescription').value = description || '';
    document.getElementById('fMaxLimit').value = maxLimit === null || maxLimit === undefined ? '' : maxLimit;
    document.getElementById('fRegime').value = regime || 'Old';
    document.getElementById('fOrder').value = order || 0;
    document.getElementById('fReqDoc').checked = reqDoc !== false;
    document.getElementById('fActive').checked = active !== false;
    itemModal.show();
}
function toggleIt(id) {
    fetch('@Url.Action("ToggleSection")', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `id=${id}` })
        .then(r => r.json()).then(d => { if (d.success) location.reload(); });
}
</script>
}
