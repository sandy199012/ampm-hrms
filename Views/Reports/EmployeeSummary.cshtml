@model List<EmployeeSummaryRow>
@{
    ViewData["Title"] = "Employee Summary";
    ViewData["Subtitle"] = "Reports";
    int year = ViewBag.Year; int month = ViewBag.Month; string monthLabel = ViewBag.MonthLabel;
}

<div class="page-header">
    <div>
        <h1>Employee Summary</h1>
        <p>@monthLabel — per-employee rollup</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="number" name="year" value="@year" class="form-control" style="width:100px;" />
            <select name="month" class="form-select" style="width:150px;">
                @for (int mo = 1; mo <= 12; mo++) { <option value="@mo" selected="@(mo==month)">@(new DateTime(2000,mo,1).ToString("MMMM"))</option> }
            </select>
            <button type="submit" class="btn btn-light">Go</button>
        </form>
        <a class="btn btn-primary" href="@Url.Action("ExportExcel", new { year, month })"><i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0" style="overflow-x:auto;">
        <table class="table table-sm mb-0" style="font-size:12.5px;">
            <thead>
                <tr>
                    <th rowspan="2" style="vertical-align:middle;">Employee</th>
                    <th rowspan="2" style="vertical-align:middle;">Dept</th>
                    <th colspan="4" class="text-center">Attendance</th>
                    <th colspan="4" class="text-center">Leave</th>
                    <th colspan="3" class="text-center">Regularisation</th>
                    <th colspan="3" class="text-center">WFH</th>
                    <th colspan="2" class="text-center">OD</th>
                </tr>
                <tr>
                    <th class="text-center">Present</th><th class="text-center">Absent</th><th class="text-center">Leave</th><th class="text-center">WO</th>
                    <th class="text-center">Total</th><th class="text-center">✅</th><th class="text-center">⏳</th><th class="text-center">Other</th>
                    <th class="text-center">Total</th><th class="text-center">✅</th><th class="text-center">⏳</th>
                    <th class="text-center">Total</th><th class="text-center">✅</th><th class="text-center">⏳</th>
                    <th class="text-center">Total</th><th class="text-center">✅</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Employee.EmpCode — @r.Employee.Name</td>
                    <td>@r.Employee.Department?.Name</td>
                    <td class="text-center">@r.Present</td><td class="text-center">@r.Absent</td><td class="text-center">@r.LeaveDays</td><td class="text-center">@r.WeekOff</td>
                    <td class="text-center">@r.LeaveTotal</td><td class="text-center">@r.LeaveApproved</td><td class="text-center">@r.LeavePending</td><td class="text-center">@r.LeaveOther</td>
                    <td class="text-center">@r.RegTotal</td><td class="text-center">@r.RegApproved</td><td class="text-center">@r.RegPending</td>
                    <td class="text-center">@r.WfhTotal</td><td class="text-center">@r.WfhApproved</td><td class="text-center">@r.WfhPending</td>
                    <td class="text-center">@r.OdTotal</td><td class="text-center">@r.OdApproved</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
