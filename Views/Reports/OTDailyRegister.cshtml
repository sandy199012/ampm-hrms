@model List<OTDailyRegisterRow>
@{
    ViewData["Title"] = "OT - Daily OT Register";
    ViewData["Subtitle"] = "Reports";
    int year = ViewBag.Year; int month = ViewBag.Month; string monthLabel = ViewBag.MonthLabel;
}

<div class="page-header">
    <div>
        <h1>OT - Daily OT Register</h1>
        <p>@monthLabel — @Model.Count day(s) with OT credited</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="number" name="year" value="@year" class="form-control" style="width:100px;" />
            <select name="month" class="form-select" style="width:150px;">
                @for (int mo = 1; mo <= 12; mo++) { <option value="@mo" selected="@(mo==month)">@(new DateTime(2000,mo,1).ToString("MMMM"))</option> }
            </select>
            <button type="submit" class="btn btn-light">Go</button>
        </form>
        <a class="btn btn-primary" href="@Url.Action("ExportExcel", new { year, month })"><i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel</a>
    </div>
</div>

<div class="alert alert-info" style="font-size:12.5px;">🟢 Retail Workers (OT after In+9h) &nbsp;|&nbsp; 🟠 Non-Retail Sunday/Holiday/Night flat-8h rule &nbsp;|&nbsp; 🟣 OT Hours</div>

<div class="card">
    <div class="card-body p-0" style="overflow-x:auto;max-height:75vh;">
        @if (!Model.Any())
        {
            <div class="empty-state"><i class="bi bi-clock-history"></i>No OT recorded this month.</div>
        }
        else
        {
            <table class="table table-sm mb-0" style="font-size:12px;">
                <thead style="position:sticky;top:0;background:#fff;">
                    <tr><th>Date</th><th>Day</th><th>Dept</th><th>Employee</th><th>Code</th><th>Designation</th><th>In</th><th>Out</th><th>9h End / Shift End</th><th>Extra Mins</th><th>OT Rule</th><th class="text-center">OT Hours</th></tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    bool sundayHolidayFlat = (r.Daily.OTRule ?? "").Contains("Sunday") || (r.Daily.OTRule ?? "").Contains("Holiday") || (r.Daily.OTRule ?? "").Contains("Night");
                    string rowStyle = r.Daily.IsRetailOT ? "background:#D6E4BC;" : sundayHolidayFlat ? "background:#FFE2CC;" : "";
                    var date = DateTime.Parse(r.Daily.Date);
                    <tr style="@rowStyle">
                        <td>@date.ToString("dd-MMM-yyyy")</td><td>@date.ToString("ddd")</td><td>@r.Employee.Department?.Name</td>
                        <td>@r.Employee.Name</td><td>@r.Employee.EmpCode</td><td>@r.Employee.Designation?.Name</td>
                        <td>@(r.Daily.InTime?.ToString(@"hh\:mm\:ss") ?? "")</td><td>@(r.Daily.OutTime?.ToString(@"hh\:mm\:ss") ?? "")</td>
                        <td>@r.Boundary</td><td>@(r.Daily.ExtraMinutes?.ToString() ?? "—")</td><td>@r.Daily.OTRule</td>
                        <td class="text-center" style="background:#E2CFED;">@r.Daily.OTHours</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
