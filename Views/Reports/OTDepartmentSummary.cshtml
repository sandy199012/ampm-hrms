@model List<OTDepartmentSummaryRow>
@{
    ViewData["Title"] = "OT - Department Summary";
    ViewData["Subtitle"] = "Reports";
    int year = ViewBag.Year; int month = ViewBag.Month; string monthLabel = ViewBag.MonthLabel;
}

<div class="page-header">
    <div>
        <h1>OT - Department Summary</h1>
        <p>@monthLabel</p>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <input type="number" name="year" value="@year" class="form-control" style="width:100px;" />
            <select name="month" class="form-select" style="width:150px;">
                @for (int mo = 1; mo <= 12; mo++) { <option value="@mo" selected="@(mo==month)">@(new DateTime(2000,mo,1).ToString("MMMM"))</option> }
            </select>
            <button type="submit" class="btn btn-light">Go</button>
        </form>
        <a class="btn btn-primary" href="@Url.Action("ExportExcel", new { year, month })"><i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0" style="overflow-x:auto;">
        <table class="table mb-0">
            <thead><tr><th>Department</th><th class="text-center">Employees</th><th class="text-center">Present</th><th class="text-center">Absent</th><th class="text-center">Miss Punch</th><th class="text-center">Leave</th><th class="text-center">Avg Absent/Emp</th><th class="text-center">Avg Miss/Emp</th><th class="text-center">Worker OT Hrs</th><th class="text-center">Attendance %</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Department</td><td class="text-center">@r.Employees</td><td class="text-center">@r.Present</td>
                    <td class="text-center">@r.Absent</td><td class="text-center">@r.MissPunch</td><td class="text-center">@r.Leave</td>
                    <td class="text-center">@r.AvgAbsentPerEmp</td><td class="text-center">@r.AvgMissPerEmp</td>
                    <td class="text-center">@(r.WorkerOTHrs > 0 ? r.WorkerOTHrs.ToString() : "")</td>
                    <td class="text-center">@r.AttendancePercent%</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
