@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "2-step verification";
}
<h2><i class="bi bi-shield-lock me-1"></i> 2-step verification</h2>
<p class="sub">Open your authenticator app (Google / Microsoft Authenticator) and enter the 6-digit code.</p>
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger mb-3"><i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.Error</div>
}
<form method="post" asp-action="TwoFactor">
    @Html.AntiForgeryToken()
    <input type="text" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9 ]{6,7}" class="form-control otp-input mb-3" placeholder="000000" required autofocus />
    <button class="btn btn-primary w-100 py-2">Verify</button>
</form>
<p class="text-center mt-3"><a asp-action="Login" class="small">Back to sign in</a></p>
