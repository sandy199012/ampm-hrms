@model List<AmpmHrmsPro.Models.Payslip>
@using System.Globalization
@{
    Layout = null;
    string coName = ViewData["CoName"] as string ?? "";
    string coAddress = ViewData["CoAddress"] as string ?? "";
    string? coLogo = ViewData["CoLogo"] as string;
    var addrParts = coAddress.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    string addr1 = string.Join(", ", addrParts.Take(2));
    string addr2 = string.Join(", ", addrParts.Skip(2));
    var inr = new CultureInfo("en-IN");
    string Money(decimal v) => v.ToString("#,##0.00", inr);
    string Whole(decimal v) => v.ToString("#,##0", inr);
    string Days(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    string Doj(string? d) => DateTime.TryParse(d, CultureInfo.InvariantCulture, DateTimeStyles.None, out var x) ? x.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) : (d ?? "—");
    string Or(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
    string title = Model.Count == 1
        ? $"Payslip {Model[0].EmpCode} {new DateTime(Model[0].Year, Model[0].Month, 1):MMM-yyyy}"
        : Model.Count > 0 ? $"Payslips {new DateTime(Model[0].Year, Model[0].Month, 1):MMM-yyyy}" : "Payslip";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <style>
        :root {
            --brand: #723E28; --brand-dark: #4A2618; --brand-soft: #F1E4D9; --accent: #C1905F;
            --cream: #FBF7F3; --ink: #2B1C15; --muted: #8A786C; --line: #EADFD5;
        }
        * { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        body { margin: 0; background: #EFE9E3; color: var(--ink); font-family: "Segoe UI", Arial, Helvetica, sans-serif; font-size: 12.5px; }
        .toolbar { position: sticky; top: 0; z-index: 5; background: var(--brand-dark); color: #fff; padding: 10px 16px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .toolbar button, .toolbar a { background: #fff; color: var(--brand-dark); border: 0; border-radius: 8px; padding: 7px 14px; font-weight: 700; cursor: pointer; text-decoration: none; font-size: 13px; }
        .toolbar .hint { opacity: .8; font-size: 12px; }

        .page { width: 210mm; min-height: 270mm; margin: 18px auto; background: #fff; box-shadow: 0 4px 24px rgba(74,38,24,.12); display: flex; flex-direction: column; }
        .head { background: linear-gradient(120deg, #85492F 0%, var(--brand) 45%, var(--brand-dark) 100%); color: #fff; padding: 22px 28px; display: flex; align-items: center; gap: 18px; }
        .head img { width: 64px; height: 64px; border-radius: 14px; box-shadow: 0 0 0 2px rgba(255,255,255,.35); }
        .head .co { flex: 1; min-width: 0; }
        .head .name { font-size: 19px; font-weight: 800; letter-spacing: .6px; }
        .head .addr { font-size: 11.5px; opacity: .85; margin-top: 3px; line-height: 1.45; }
        .head .tag { text-align: right; }
        .head .tag .t1 { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; opacity: .8; }
        .head .tag .t2 { font-size: 20px; font-weight: 800; margin-top: 2px; white-space: nowrap; }
        .stripe { height: 5px; background: var(--accent); }

        .body { padding: 22px 28px 18px; flex: 1; }
        .who { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; border-bottom: 1px solid var(--line); padding-bottom: 14px; }
        .who .nm { font-size: 18px; font-weight: 800; color: var(--brand-dark); }
        .who .sub { color: var(--muted); margin-top: 3px; }
        .who .code { background: var(--brand-soft); color: var(--brand); font-weight: 800; padding: 6px 12px; border-radius: 999px; white-space: nowrap; }

        .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px 18px; padding: 14px 0 16px; }
        .grid .k { font-size: 10px; letter-spacing: .8px; text-transform: uppercase; color: var(--muted); font-weight: 700; }
        .grid .v { margin-top: 2px; font-weight: 600; word-break: break-word; }

        .days { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 18px; }
        .chip { background: var(--cream); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; }
        .chip .k { font-size: 10px; letter-spacing: .8px; text-transform: uppercase; color: var(--muted); font-weight: 700; }
        .chip .v { font-size: 18px; font-weight: 800; color: var(--brand-dark); margin-top: 2px; }
        .chip.lop .v { color: #B4442A; }

        .money { display: grid; grid-template-columns: 1.25fr 1fr; gap: 16px; }
        .card { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
        .card h3 { margin: 0; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; padding: 10px 14px; background: var(--brand-soft); color: var(--brand); }
        table { width: 100%; border-collapse: collapse; }
        th { font-size: 10px; letter-spacing: .8px; text-transform: uppercase; color: var(--muted); text-align: left; padding: 8px 14px 6px; font-weight: 700; }
        td { padding: 6px 14px; border-top: 1px solid #F3ECE5; }
        .r { text-align: right; white-space: nowrap; }
        tr.tot td { border-top: 1.5px solid var(--line); font-weight: 800; background: var(--cream); padding-top: 9px; padding-bottom: 9px; }
        .zero { color: #B9AAA0; }

        .net { margin-top: 18px; border-radius: 14px; background: linear-gradient(120deg, var(--brand) 0%, var(--brand-dark) 100%); color: #fff; padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
        .net .k { font-size: 11px; letter-spacing: 1.6px; text-transform: uppercase; opacity: .8; }
        .net .words { font-size: 12.5px; margin-top: 4px; opacity: .95; }
        .net .amt { font-size: 28px; font-weight: 900; white-space: nowrap; }
        .sum { display: flex; gap: 22px; margin-top: 10px; color: var(--muted); font-size: 11.5px; flex-wrap: wrap; }
        .sum b { color: var(--ink); }
        .remark { margin-top: 12px; padding: 9px 12px; border-left: 3px solid var(--accent); background: var(--cream); font-size: 12px; }

        .foot { padding: 12px 28px 16px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; color: var(--muted); font-size: 10.5px; gap: 12px; }

        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .page { margin: 0; box-shadow: none; width: auto; min-height: 0; height: 277mm; overflow: hidden; page-break-after: always; break-after: page; }
            .page:last-child { page-break-after: auto; break-after: auto; }
            @@page { size: A4; margin: 8mm; }
        }
        @@media screen and (max-width: 820px) {
            .page { width: auto; margin: 10px; min-height: 0; }
            .head { padding: 16px; } .head img { width: 46px; height: 46px; } .head .name { font-size: 15px; } .head .tag .t2 { font-size: 15px; }
            .body { padding: 16px; } .grid, .days { grid-template-columns: repeat(2, 1fr); } .money { grid-template-columns: 1fr; }
            .net { flex-direction: column; align-items: flex-start; } .net .amt { font-size: 24px; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">Print / Save as PDF</button>
        <a href="javascript:history.back()">Back</a>
        <span class="hint">@(Model.Count) payslip(s) — in the print window choose "Save as PDF" to download.</span>
    </div>

    @foreach (var s in Model)
    {
        var month = new DateTime(s.Year, s.Month, 1).ToString("MMMM yyyy", CultureInfo.InvariantCulture);
        // Only components that apply to this employee (non-zero), plus PF / ESIC which are always shown.
        var earn = s.Lines.Where(l => l.Type == "Earning" && (l.Rate != 0 || l.Amount != 0)).OrderBy(l => l.DisplayOrder).ToList();
        var ded = s.Lines.Where(l => l.Type == "Deduction" && (l.Amount != 0 || AmpmHrmsPro.Services.PayrollEngine.IsCode(l, "EPF", "PF", "ESIC", "ESI"))).OrderBy(l => l.DisplayOrder).ToList();
        <div class="page">
            <div class="head">
                @if (!string.IsNullOrEmpty(coLogo)) { <img src="@coLogo" alt="Logo" /> }
                <div class="co">
                    <div class="name">@coName</div>
                    <div class="addr">@addr1@(addr2.Length > 0 ? "," : "")<br />@addr2.ToUpperInvariant()</div>
                </div>
                <div class="tag">
                    <div class="t1">Salary Slip</div>
                    <div class="t2">@month</div>
                </div>
            </div>
            <div class="stripe"></div>

            <div class="body">
                <div class="who">
                    <div>
                        <div class="nm">@s.EmployeeName</div>
                        <div class="sub">@Or(s.Designation) · @Or(s.Department)</div>
                    </div>
                    <div class="code">Emp. Code @s.EmpCode</div>
                </div>

                <div class="grid">
                    <div><div class="k">F / H Name</div><div class="v">@Or(s.FatherOrHusbandName)</div></div>
                    <div><div class="k">Date of Joining</div><div class="v">@Doj(s.DOJ)</div></div>
                    <div><div class="k">P.F. Number</div><div class="v">@Or(s.PFNumber)</div></div>
                    <div><div class="k">UAN</div><div class="v">@Or(s.UANNumber)</div></div>
                    <div><div class="k">PAN</div><div class="v">@Or(s.PANNumber)</div></div>
                    <div><div class="k">ESI Number</div><div class="v">@Or(s.ESICNumber)</div></div>
                    <div style="grid-column: span 2"><div class="k">Bank A/c No.</div><div class="v">@Or(s.BankAccount)</div></div>
                </div>

                <div class="days">
                    <div class="chip"><div class="k">Days in Month</div><div class="v">@Days(s.DaysInMonth)</div></div>
                    <div class="chip"><div class="k">Paid Days</div><div class="v">@Days(s.PaidDays)</div></div>
                    <div class="chip"><div class="k">Leave (Paid)</div><div class="v">@Days(s.LeaveDays)</div></div>
                    <div class="chip lop"><div class="k">Loss of Pay</div><div class="v">@Days(Math.Max(0, s.DaysInMonth - s.PaidDays))</div></div>
                </div>

                <div class="money">
                    <div class="card">
                        <h3>Earnings</h3>
                        <table>
                            <tr><th>Component</th><th class="r">Monthly Rate</th><th class="r">Earned (₹)</th></tr>
                            @foreach (var e in earn)
                            {
                                <tr><td>@e.Name</td><td class="r">@Whole(e.Rate)</td><td class="r">@Whole(e.Amount)</td></tr>
                            }
                            <tr class="tot"><td>Gross Earnings</td><td class="r">@Whole(s.GrossRate)</td><td class="r">@Money(s.GrossEarned)</td></tr>
                        </table>
                    </div>
                    <div class="card">
                        <h3>Deductions</h3>
                        <table>
                            <tr><th>Component</th><th class="r">Amount (₹)</th></tr>
                            @foreach (var d in ded)
                            {
                                <tr><td>@d.Name</td><td class="r @(d.Amount == 0 ? "zero" : "")">@Whole(d.Amount)</td></tr>
                            }
                            <tr class="tot"><td>Total Deductions</td><td class="r">@Money(s.TotalDeductions)</td></tr>
                        </table>
                    </div>
                </div>

                <div class="net">
                    <div>
                        <div class="k">Net Pay for @month</div>
                        <div class="words">@AmpmHrmsPro.Services.PayrollEngine.InWords(s.NetPay)</div>
                    </div>
                    <div class="amt">₹ @Money(s.NetPay)</div>
                </div>
                <div class="sum">
                    <span>Gross Earnings <b>₹ @Money(s.GrossEarned)</b></span>
                    <span>− Deductions <b>₹ @Money(s.TotalDeductions)</b></span>
                    <span>= Net Pay <b>₹ @Money(s.NetPay)</b></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(s.Remarks)) { <div class="remark"><b>Remarks:</b> @s.Remarks</div> }
            </div>

            <div class="foot">
                <span>This is a computer-generated payslip and does not require a signature.</span>
                <span>Generated @AmpmHrmsPro.Services.IndiaTime.FromUtc(s.UpdatedAt).ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</span>
            </div>
        </div>
    }
</body>
</html>
